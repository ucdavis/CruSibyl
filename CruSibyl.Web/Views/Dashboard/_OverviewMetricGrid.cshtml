@using CruSibyl.Web.Models.Dashboard
@model IEnumerable<DashboardMetricModel>

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 2xl:grid-cols-3">
  @foreach (var metric in Model)
  {
    <button type="button"
            class="@MetricButtonClass(metric)"
            title="@(metric.CanOpen ? metric.Description : $"{metric.Description} No detail rows to show.")"
            aria-label="@($"{metric.Label}: {metric.Count}")"
            disabled="@(!metric.CanOpen)"
            hx-get="@(metric.CanOpen ? metric.Url : null)"
            hx-target="@(metric.CanOpen ? "#dashboard-detail-modal-body" : null)"
            hx-swap="@(metric.CanOpen ? "innerHTML" : null)"
            data-hc-open-modal="@(metric.CanOpen ? "dashboard-detail-modal" : null)">
      <span class="flex w-full items-start justify-between gap-3">
        <span class="text-sm font-medium text-base-content">@metric.Label</span>
        <i class="@metric.IconClass opacity-80" aria-hidden="true"></i>
      </span>
      <span class="mt-3 text-3xl font-bold leading-none">@metric.Count</span>
      <span class="mt-2 text-xs leading-5 text-base-content/70">@metric.Description</span>
    </button>
  }
</div>

@functions {
  private static string MetricButtonClass(DashboardMetricModel metric)
  {
    var toneClass = metric.Tone switch
    {
      DashboardMetricTone.Info => "border-info/40 text-info",
      DashboardMetricTone.Success => "border-success/40 text-success",
      DashboardMetricTone.Warning => "border-warning/50 text-warning",
      DashboardMetricTone.Error => "border-error/50 text-error",
      _ => "border-base-300 text-base-content"
    };

    return $"group flex min-h-28 w-full flex-col justify-between rounded-lg border bg-base-100 p-4 text-left shadow-sm transition hover:border-primary hover:bg-base-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:cursor-default disabled:opacity-55 disabled:hover:border-base-300 disabled:hover:bg-base-100 {toneClass}";
  }
}
