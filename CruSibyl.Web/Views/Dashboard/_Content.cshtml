@using CruSibyl.Web.Models.Dashboard
@using Htmx.Components.Modal.Models
@model DashboardViewModel

@{
  var webJobMetrics = new[]
  {
    new DashboardMetricModel { Label = "Enabled jobs", Count = Model.WebJobs.TotalEnabledJobs, Url = "/Dashboard/Details/WebJobs?filter=TotalEnabled", IconClass = "fas fa-briefcase", Tone = DashboardMetricTone.Info, Description = "All enabled WebJobs on enabled apps." },
    new DashboardMetricModel { Label = "Running", Count = Model.WebJobs.RunningJobs, Url = "/Dashboard/Details/WebJobs?filter=Running", IconClass = "fas fa-play", Tone = DashboardMetricTone.Success, Description = "Jobs currently reporting a running status." },
    new DashboardMetricModel { Label = "Last run failed", Count = Model.WebJobs.JobsWithFailedLastRun, Url = "/Dashboard/Details/WebJobs?filter=FailedLastRun", IconClass = "fas fa-times-circle", Tone = DashboardMetricTone.Error, Description = "Jobs whose latest run failed." },
    new DashboardMetricModel { Label = "Recently failed", Count = Model.WebJobs.JobsRecentlyFailed, Url = "/Dashboard/Details/WebJobs?filter=RecentlyFailed", IconClass = "fas fa-history", Tone = DashboardMetricTone.Warning, Description = $"Failures in the last {Model.Windows.RecentFailureWindowHours} hours." },
    new DashboardMetricModel { Label = $"Failed last {Model.Windows.ConsecutiveFailureAttempts}", Count = Model.WebJobs.JobsFailingConsecutiveAttempts, Url = "/Dashboard/Details/WebJobs?filter=ConsecutiveFailures", IconClass = "fas fa-redo", Tone = DashboardMetricTone.Error, Description = "Jobs failing consecutive attempts." }
  };

  var platformMetrics = new[]
  {
    new DashboardMetricModel { Label = "Apps with manifests", Count = Model.Platform.EnabledAppsWithManifests, Url = "/Dashboard/Details/Platforms?filter=WithManifests", IconClass = "fas fa-file-code", Tone = DashboardMetricTone.Info, Description = "Mapped enabled apps with manifest data." },
    new DashboardMetricModel { Label = "Outdated apps", Count = Model.Platform.AppsOnOutdatedManifestPlatformVersions, Url = "/Dashboard/Details/Platforms?filter=Outdated", IconClass = "fas fa-code-branch", Tone = DashboardMetricTone.Warning, Description = "Apps whose manifest platform is behind latest stable." },
    new DashboardMetricModel { Label = "Outdated repos", Count = Model.Platform.ReposOnOutdatedManifestPlatformVersions, Url = "/Dashboard/Details/Platforms?filter=Outdated", IconClass = "fas fa-project-diagram", Tone = DashboardMetricTone.Warning, Description = "Repos with at least one outdated manifest platform." },
    new DashboardMetricModel { Label = "Unknown versions", Count = Model.Platform.UnknownPlatformVersionData, Url = "/Dashboard/Details/Platforms?filter=Unknown", IconClass = "fas fa-question", Tone = DashboardMetricTone.Neutral, Description = "Manifest versions that cannot be compared." },
    new DashboardMetricModel { Label = "Failed scans", Count = Model.Platform.FailedManifestScans, Url = "/Dashboard/Details/Platforms?filter=FailedScans", IconClass = "fas fa-exclamation-triangle", Tone = DashboardMetricTone.Error, Description = "Repos whose manifest scan failed." },
    new DashboardMetricModel { Label = "Stale scans", Count = Model.Platform.StaleManifestScans, Url = "/Dashboard/Details/Platforms?filter=StaleScans", IconClass = "fas fa-hourglass-half", Tone = DashboardMetricTone.Warning, Description = $"Repos not scanned in {Model.Windows.StaleScanDays} days." }
  };

  var dependencyMetrics = new[]
  {
    new DashboardMetricModel { Label = "Tracked dependencies", Count = Model.Dependency.TotalTrackedDependencies, Url = "/Dashboard/Details/Dependencies?filter=All", IconClass = "fas fa-cubes", Tone = DashboardMetricTone.Info, Description = "All dependencies discovered from manifests." },
    new DashboardMetricModel { Label = "Outdated", Count = Model.Dependency.OutdatedDependencies, Url = "/Dashboard/Details/Dependencies?filter=Outdated", IconClass = "fas fa-chart-line", Tone = DashboardMetricTone.Warning, Description = "Dependencies behind the latest stable version." },
    new DashboardMetricModel { Label = "Major behind", Count = Model.Dependency.MajorBehindDependencies, Url = "/Dashboard/Details/Dependencies?filter=Major", IconClass = "fas fa-angle-double-up", Tone = DashboardMetricTone.Error, Description = "Current major version is behind latest stable." },
    new DashboardMetricModel { Label = "Minor behind", Count = Model.Dependency.MinorBehindDependencies, Url = "/Dashboard/Details/Dependencies?filter=Minor", IconClass = "fas fa-angle-up", Tone = DashboardMetricTone.Warning, Description = "Current minor version is behind latest stable." },
    new DashboardMetricModel { Label = "Patch behind", Count = Model.Dependency.PatchBehindDependencies, Url = "/Dashboard/Details/Dependencies?filter=Patch", IconClass = "fas fa-code-branch", Tone = DashboardMetricTone.Info, Description = "Current patch version is behind latest stable." },
    new DashboardMetricModel { Label = "Unknown", Count = Model.Dependency.UnknownCurrencyDependencies, Url = "/Dashboard/Details/Dependencies?filter=Unknown", IconClass = "fas fa-question", Tone = DashboardMetricTone.Neutral, Description = "Dependency versions that cannot be compared." },
    new DashboardMetricModel { Label = "High priority", Count = Model.Dependency.HighPriorityOutdatedDependencies, Url = "/Dashboard/Details/Dependencies?filter=HighPriority", IconClass = "fas fa-fire", Tone = DashboardMetricTone.Error, Description = "Outdated dependencies weighted by app importance." }
  };

  var appMappingMetrics = new[]
  {
    new DashboardMetricModel { Label = "Enabled apps", Count = Model.AppMappings.EnabledApps, IconClass = "fas fa-window-restore", Tone = DashboardMetricTone.Neutral, Description = "Enabled apps included in dashboard coverage." },
    new DashboardMetricModel { Label = "Mapped repos", Count = Model.AppMappings.EnabledAppsWithMappedRepos, IconClass = "fas fa-link", Tone = DashboardMetricTone.Success, Description = "Enabled apps with a mapped repo." },
    new DashboardMetricModel { Label = "Unmapped apps", Count = Model.AppMappings.UnmappedEnabledApps, Url = "/Dashboard/Details/AppMappings?filter=Unmapped", IconClass = "fas fa-unlink", Tone = DashboardMetricTone.Error, Description = "Enabled apps that need a repo mapping." },
    new DashboardMetricModel { Label = "Manifestless repos", Count = Model.AppMappings.MappedAppsWithManifestlessRepos, Url = "/Dashboard/Details/AppMappings?filter=Manifestless", IconClass = "fas fa-folder-open", Tone = DashboardMetricTone.Warning, Description = "Mapped repos with no manifests." },
    new DashboardMetricModel { Label = "Stale repo scans", Count = Model.AppMappings.MappedAppsWithStaleRepoScans, Url = "/Dashboard/Details/AppMappings?filter=StaleRepoScans", IconClass = "fas fa-hourglass-half", Tone = DashboardMetricTone.Warning, Description = $"Mapped repos not scanned in {Model.Windows.StaleScanDays} days." },
    new DashboardMetricModel { Label = "Failed repo scans", Count = Model.AppMappings.MappedAppsWithFailedRepoScans, Url = "/Dashboard/Details/AppMappings?filter=FailedRepoScans", IconClass = "fas fa-exclamation-triangle", Tone = DashboardMetricTone.Error, Description = "Mapped repos whose latest scan failed." }
  };

  var freshnessMetrics = new[]
  {
    new DashboardMetricModel { Label = "Stale repo scans", Count = Model.DataFreshness.StaleRepoScans, Url = "/Dashboard/Details/Freshness?filter=StaleRepoScans", IconClass = "fas fa-hourglass-half", Tone = DashboardMetricTone.Warning, Description = $"Repos not scanned in {Model.Windows.StaleScanDays} days." },
    new DashboardMetricModel { Label = "Failed repo scans", Count = Model.DataFreshness.FailedRepoScans, Url = "/Dashboard/Details/Freshness?filter=FailedRepoScans", IconClass = "fas fa-exclamation-triangle", Tone = DashboardMetricTone.Error, Description = "Repos whose latest scan failed." },
    new DashboardMetricModel { Label = "Stale package scans", Count = Model.DataFreshness.StalePackageScans, Url = "/Dashboard/Details/Freshness?filter=StalePackageScans", IconClass = "fas fa-box-open", Tone = DashboardMetricTone.Warning, Description = $"Packages not scanned in {Model.Windows.StaleScanDays} days." },
    new DashboardMetricModel { Label = "Failed package scans", Count = Model.DataFreshness.FailedPackageScans, Url = "/Dashboard/Details/Freshness?filter=FailedPackageScans", IconClass = "fas fa-bug", Tone = DashboardMetricTone.Error, Description = "Package registry scans whose latest attempt failed." },
    new DashboardMetricModel { Label = "Apps without repos", Count = Model.DataFreshness.AppsWithoutRepos, Url = "/Dashboard/Details/Freshness?filter=AppsWithoutRepos", IconClass = "fas fa-unlink", Tone = DashboardMetricTone.Error, Description = "Enabled apps missing repo mappings." },
    new DashboardMetricModel { Label = "Repos without manifests", Count = Model.DataFreshness.ReposWithoutManifests, Url = "/Dashboard/Details/Freshness?filter=ReposWithoutManifests", IconClass = "fas fa-question-circle", Tone = DashboardMetricTone.Warning, Description = "Repos with no manifest records." }
  };

  var dependencyCoverageTotal = Model.Dependency.EnabledAppsWithDependencyCoverage + Model.Dependency.EnabledAppsWithoutDependencyCoverage;
  var dependencyCoveragePercent = dependencyCoverageTotal == 0
    ? 0
    : (int)Math.Round((double)Model.Dependency.EnabledAppsWithDependencyCoverage / dependencyCoverageTotal * 100);
}

<htmx-request-scope id="main-content"
                    class="relative flex flex-col gap-5"
                    data-dashboard-root
                    data-hc-request-indicator-selector="find [data-hc-dashboard-refresh-indicator]"
                    data-hc-stale-region-selector="find [data-hc-dashboard-overview]"
                    hx-get="/Dashboard"
                    hx-trigger="dashboard:refresh"
                    hx-target="this"
                    hx-swap="outerHTML">
  <div class="hc-request-indicator" data-hc-request-indicator data-hc-dashboard-refresh-indicator hidden aria-hidden="true" style="inset: 1rem 1rem auto auto;">
    <span class="hc-request-indicator-spinner" aria-hidden="true"></span>
    <span class="hc-request-indicator-label">Refreshing</span>
  </div>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold">Dashboard</h2>
      <p class="text-sm opacity-70">
        Captured @Model.CapturedAtUtc.ToString("u") | recent failures use @Model.Windows.RecentFailureWindowHours h | stale scans use @Model.Windows.StaleScanDays d
      </p>
    </div>
  </div>

  <htmx-request-scope id="dashboard-detail-scope"
                      class="relative flex flex-col gap-5"
                      data-hc-pending-disable="scope"
                      data-hc-pending-disable-selector="button, input, select, textarea, a, [tabindex]"
                      data-hc-request-indicator-selector="find [data-hc-detail-request-indicator]"
                      data-hc-stale-region-selector="find [data-hc-dashboard-detail-region]">
    <div class="hc-request-indicator" data-hc-request-indicator data-hc-detail-request-indicator hidden aria-hidden="true" style="inset: 50% auto auto 50%; transform: translate(-50%, -50%);">
      <span class="hc-request-indicator-spinner" aria-hidden="true"></span>
      <span class="hc-request-indicator-label">Loading</span>
    </div>

    <htmx-error-region class="alert alert-error" hidden></htmx-error-region>

    <div data-hc-dashboard-overview class="grid grid-cols-1 gap-5 xl:grid-cols-2">
      <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold">WebJobs</h3>
            <p class="text-sm opacity-70">Runtime state and failure signals for enabled app jobs.</p>
          </div>
          <button type="button"
                  class="btn btn-outline btn-sm"
                  hx-get="/Dashboard/FailureHistory"
                  hx-target="#dashboard-detail-modal-body"
                  hx-swap="innerHTML"
                  data-hc-open-modal="dashboard-detail-modal">
            <i class="fas fa-history" aria-hidden="true"></i>
            History
          </button>
        </div>
        @await Html.PartialAsync("_OverviewMetricGrid", webJobMetrics)
      </section>

      <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
        <div class="mb-4">
          <h3 class="text-lg font-semibold">Platform Currency</h3>
          <p class="text-sm opacity-70">Manifest platform coverage, stale scans, and version drift.</p>
        </div>
        @await Html.PartialAsync("_OverviewMetricGrid", platformMetrics)
      </section>

      <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
        <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <h3 class="text-lg font-semibold">Dependency Currency</h3>
            <p class="text-sm opacity-70">Version drift by severity with app importance folded into priority.</p>
          </div>
          <div class="min-w-48 rounded-lg border border-base-300 bg-base-200/60 px-3 py-2">
            <div class="flex items-center justify-between gap-3 text-xs font-medium uppercase tracking-wide opacity-70">
              <span>Coverage</span>
              <span>@dependencyCoveragePercent%</span>
            </div>
            <progress class="progress progress-primary mt-2 w-full" value="@dependencyCoveragePercent" max="100"></progress>
            <div class="mt-1 text-xs opacity-70">@Model.Dependency.EnabledAppsWithDependencyCoverage of @dependencyCoverageTotal enabled apps</div>
          </div>
        </div>
        @await Html.PartialAsync("_OverviewMetricGrid", dependencyMetrics)
      </section>

      <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
        <div class="mb-4">
          <h3 class="text-lg font-semibold">App Mapping</h3>
          <p class="text-sm opacity-70">Repo mapping coverage, with unmapped apps editable in place.</p>
        </div>
        @await Html.PartialAsync("_OverviewMetricGrid", appMappingMetrics)
      </section>

      <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm xl:col-span-2">
        <div class="mb-4">
          <h3 class="text-lg font-semibold">Data Freshness</h3>
          <p class="text-sm opacity-70">Scan age, scan failures, and coverage gaps that can skew reporting.</p>
        </div>
        @await Html.PartialAsync("_OverviewMetricGrid", freshnessMetrics)
      </section>
    </div>

    <div id="dashboard-detail-content" class="sr-only" data-hc-dashboard-detail-region></div>
  </htmx-request-scope>

  @await Component.InvokeAsync("Modal", new ModalModel
  {
    Id = "dashboard-detail-modal",
    Title = "Dashboard Detail",
    Size = ModalSize.ExtraLarge,
    BodyTargetId = "dashboard-detail-modal-body",
    CloseLabel = "Close dashboard detail"
  })
</htmx-request-scope>
